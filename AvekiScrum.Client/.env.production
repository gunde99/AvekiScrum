# Byggtidsvariabler för produktionsbygget (npm run build). Inga hemligheter: client- och tenant-id
# syns ändå i varje inloggningsanrop. Ligger här så att ingen behöver sätta dem för hand.
VITE_ENTRA_TENANT_ID=48e7c764-137b-4c2b-8521-8e0e1f19f10b
VITE_ENTRA_CLIENT_ID=6e3b9cf6-9ec1-4778-b337-f6676e0c2afa
VITE_API_SCOPE=api://36cb84e8-d1c9-4ddf-9c19-1712645da02b/access_as_user
# Klienten serveras från samma IIS-site som API:t, så anropen går till samma origin.
VITE_API_BASE_URL=
