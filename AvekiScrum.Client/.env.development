# Läses av vite i utvecklingsläge (npm run dev). Inga hemligheter - client-id och tenant-id syns
# ändå i varje inloggningsanrop.
#
# Med de här satta kräver klienten inloggning även lokalt, vilket är hur man testar att rätt namn
# hamnar som rapportör. Kör API:t med Auth__Mode=EntraWithPat samtidigt - se docs/LOKAL_UTVECKLING.md.
# Vill du tillbaka till det gamla anonyma läget: kommentera bort de tre VITE_ENTRA/VITE_API_SCOPE-
# raderna, då stängs inloggningen av av sig själv.
VITE_ENTRA_TENANT_ID=48e7c764-137b-4c2b-8521-8e0e1f19f10b
VITE_ENTRA_CLIENT_ID=6e3b9cf6-9ec1-4778-b337-f6676e0c2afa
VITE_API_SCOPE=api://36cb84e8-d1c9-4ddf-9c19-1712645da02b/access_as_user

# API:t kör separat lokalt, till skillnad från i drift där allt ligger på samma site.
VITE_API_BASE_URL=http://localhost:5273
