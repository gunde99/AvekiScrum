# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/

# Visual Studio / Rider / user-local files
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser

# Local configuration and secrets
appsettings.Local.json
appsettings.*.Local.json
*.secrets.json
.env
.env.*
# ...utom produktionsbyggets variabler. De innehåller client-id, tenant-id och scope, som ändå
# syns i varje inloggningsanrop - och checkade in slipper den som bygger sätta dem för hand.
!AvekiScrum.Client/.env.production
!AvekiScrum.Client/.env.development

# Node / frontend (once AvekiScrum.Client exists)
node_modules/
dist/

# OS noise
Thumbs.db
Desktop.ini
.DS_Store

# Den byggda klienten kopieras hit vid publicering - byggartefakt, inte källkod.
AvekiScrum.Api/wwwroot/
publish/

# Personliga anteckningar - har innehållit klienthemligheter och ska inte checkas in.
docs/anteckningar.txt
