{
  // Läggs över appsettings.json när ASPNETCORE_ENVIRONMENT=Production, dvs. på IIS-servern.
  "Auth": {
    // "EntraWithPat" tills en administratör gett consent för API-appens Azure DevOps-behörigheter.
    // Inloggning krävs och API:t är stängt för anonyma anrop; skillnaden mot "Entra" är att korten
    // fortfarande registreras som PAT-ägaren i Azures egen historik. Byt till "Entra" när
    // consenten är på plats - det är enda ändringen som behövs.
    "Mode": "EntraWithPat"
  },
  // Skarp drift kör mot riktiga projektet, inte sandlådan.
  "Testing": {
    "ProjectOverride": "",
    "IterationPathOverride": ""
  },
  "AzureDevOps": {
    "Project": "Utveckling"
  }
}
